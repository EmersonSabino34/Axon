# Base de dados (SQLite local). Em produção, use uma URL PostgreSQL.
DATABASE_URL="file:./dev.db"
# Segredo para assinar a sessão do administrador (gere com: openssl rand -hex 32)
AUTH_SECRET="troque-por-um-segredo-longo"
# Primeiro administrador, criado pelo seed
ADMIN_EMAIL="admin@axon.com.br"
ADMIN_PASSWORD="troque-esta-senha"
