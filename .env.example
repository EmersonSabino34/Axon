# Copie para .env.local e preencha. Nunca publique o ficheiro com valores reais.

# Primeiro administrador: é criado no primeiro acesso à base de dados, se ainda não existir nenhum.
ADMIN_EMAIL=admin@exemplo.pt
ADMIN_PASSWORD=troque-esta-palavra-passe
ADMIN_NAME=Administrador

# Opcional: caminho do ficheiro da base de dados (por omissão: data/axon.db)
# DATABASE_PATH=/var/lib/axon/axon.db

# Endereço público do site, usado nos links de regresso dos pagamentos (ex.: https://www.axon.pt)
# SITE_URL=https://www.exemplo.pt

# Pagamentos: "teste" simula MB WAY, Multibanco e cartão sem dinheiro real; "ifthenpay" usa pagamentos reais.
# Sem valor: modo de teste em desenvolvimento; em produção só abre com a ifthenpay configurada.
PAYMENTS_PROVIDER=teste

# Chaves da ifthenpay (atribuídas ao contratar; há chaves de teste a pedido). Ficam só no servidor.
# IFTHENPAY_MBWAY_KEY=
# IFTHENPAY_MB_KEY=
# IFTHENPAY_CCARD_KEY=
# Chave anti-phishing escolhida por si e comunicada à ifthenpay ao ativar as notificações (callback).
# IFTHENPAY_ANTI_PHISHING_KEY=
