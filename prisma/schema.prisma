// Base de dados da AXON. Em desenvolvimento usa SQLite (ficheiro local).
// Em produção (Vercel, Railway etc.) troque o provider para "postgresql" e defina DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  label       String
  tagline     String
  format      String // liquido | capsulas | sache
  formatLabel String
  size        String
  reference   String
  benefits    String // lista separada por vírgulas
  intro       String
  details     String // um item por linha
  routine     String // um passo por linha
  supplement  Boolean     @default(true)
  toConfirm   String?
  image       String? // caminho da foto em /public, ex.: /produtos/lugol.webp
  priceCents  Int?
  stock       Int         @default(0)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  events      Event[]
}

model Order {
  id           String      @id @default(cuid())
  number       Int         @unique
  customerName String
  phone        String
  email        String?
  city         String?
  status       String      @default("novo") // novo | confirmado | enviado | entregue | cancelado
  channel      String      @default("whatsapp")
  notes        String?
  totalCents   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  // Conta do cliente no site, ligada pelo administrador. O pedido aparece em /conta.
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  product   String?
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Event {
  id        String   @id @default(cuid())
  type      String // view | whatsapp
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model Setting {
  key   String @id
  value String
}

// Clientes que criam conta no site (/cadastro). Separados dos administradores.
model Customer {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  createdAt      DateTime  @default(now())
  // Link de nova senha gerado no painel: guarda só o hash do código, com validade.
  resetTokenHash String?   @unique
  resetExpires   DateTime?
  orders         Order[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}
